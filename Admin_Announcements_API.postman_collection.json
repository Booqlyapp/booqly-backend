{
  "info": {
    "name": "Booqly Admin - Platform Announcements",
    "description": "Postman collection for Platform Announcements admin APIs (stats cards, list/filter, CRUD, publish/schedule).\n\n## Setup\n1. Import this collection into Postman.\n2. Set `baseUrl` (default: http://localhost:3000).\n3. Run **Admin Login** first — saves `adminAuthToken` automatically.\n4. Run **Get Announcement Stats** and **Create Announcement**.\n\n## Auth\nAll `/admin/announcements/*` endpoints require `Authorization: Bearer {{adminAuthToken}}` and admin role.\n\n## Status values\n`draft` | `scheduled` | `published` | `expired`\n\n## Type values\n`policy_update` | `promotion` | `system_update` | `feature_update` | `alert`\n\n## Audience values\n`all_users` | `active_users` | `clients` | `providers`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@booqlyapp.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "AdminStrongPass1",
      "type": "string"
    },
    {
      "key": "adminAuthToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "announcementId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.status && response.token) {",
                  "        pm.collectionVariables.set('adminAuthToken', response.token);",
                  "        console.log('adminAuthToken saved');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as admin. Saves token to `adminAuthToken` collection variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard Stats",
      "item": [
        {
          "name": "Get Announcement Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAuthToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/announcements/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "announcements", "stats"]
            },
            "description": "Top KPI cards: Total Announcements, Published, Scheduled, Drafts — each with count and percentChange vs last 7 days."
          },
          "response": [
            {
              "name": "Example Response",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": true,\n  \"message\": \"Announcement stats retrieved successfully\",\n  \"data\": {\n    \"totalAnnouncements\": { \"count\": 28, \"percentChange\": 12.5 },\n    \"published\": { \"count\": 16, \"percentChange\": 8.1 },\n    \"scheduled\": { \"count\": 6, \"percentChange\": 2.4 },\n    \"drafts\": { \"count\": 6, \"percentChange\": -3.2 },\n    \"period\": \"last_7_days\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Platform Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAuthToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard", "stats"]
            },
            "description": "Main admin dashboard KPIs: totalUsers, totalBookings, totalRevenue, totalActiveProviders."
          },
          "response": [
            {
              "name": "Example Response",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": true,\n  \"message\": \"Dashboard stats retrieved successfully\",\n  \"data\": {\n    \"totalUsers\": 1250,\n    \"totalBookings\": 4380,\n    \"totalRevenue\": 152340.5,\n    \"totalActiveProviders\": 86\n  }\n}"
            }
          ]
        }
      ]
    },
    {
