            "url": {
              "raw": "{{baseUrl}}/admin/announcements?page=1&limit=20&status=all",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "announcements"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "all",
                  "description": "all | draft | scheduled | published | expired"
                },
                {
                  "key": "type",
                  "value": "",
