          },
          "response": []
        },
        {
          "name": "8. Create Draft Announcement",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.status && response.data && response.data.id) {",
                  "        pm.collectionVariables.set('announcementId', response.data.id);",
                  "        console.log('announcementId saved:', response.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAuthToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Privacy Policy\",\n  \"description\": \"We've updated our privacy policy to better protect your data\",\n  \"iconType\": \"megaphone\",\n  \"audience\": \"all_users\",\n  \"type\": \"policy_update\",\n  \"status\": \"draft\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "announcements"]
            },
            "description": "Create a draft. Saves `announcementId` automatically."
          },
          "response": []
        },
