# =====================================================
# BOOQLY SERVER ENVIRONMENT VARIABLES
# =====================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Error Handling
SEND_ERRORS=false

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/booqly_db

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here

# Client URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:3000

# =====================================================
# STRIPE CONFIGURATION
# =====================================================

# API Keys
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =====================================================
# STRIPE PRICE IDs (LEGACY — subscription billing moved to IAP)
# Keep STRIPE_SECRET_KEY / webhook for booking deposits + Connect only.
# =====================================================

# Client Subscription Plans
# Yearly subscription prices (create in Stripe Dashboard, then paste price IDs here)
STRIPE_CLIENT_PREMIUM_YEARLY_PRICE_ID=
STRIPE_SOLO_BASIC_YEARLY_PRICE_ID=
STRIPE_SOLO_PRO_YEARLY_PRICE_ID=
STRIPE_SOLO_PREMIUM_YEARLY_PRICE_ID=
STRIPE_SUITE_STARTER_YEARLY_PRICE_ID=
STRIPE_SUITE_GROWING_YEARLY_PRICE_ID=
STRIPE_SUITE_PRO_YEARLY_PRICE_ID=
STRIPE_SUITE_ELITE_YEARLY_PRICE_ID=

# Solo Professional Plans
STRIPE_SOLO_BASIC_PRICE_ID=price_1234567890abcdef
STRIPE_SOLO_PRO_PRICE_ID=price_1234567890abcdef
STRIPE_SOLO_PREMIUM_PRICE_ID=price_1234567890abcdef

# Suite Owner Plans  
STRIPE_SUITE_STARTER_PRICE_ID=price_1234567890abcdef
STRIPE_SUITE_GROWING_PRICE_ID=price_1234567890abcdef
STRIPE_SUITE_PRO_PRICE_ID=price_1234567890abcdef
STRIPE_SUITE_ELITE_PRICE_ID=price_1234567890abcdef

# =====================================================
# IN-APP PURCHASE (App Store / Play Store subscriptions)
# =====================================================

# App Store Connect → Users and Access → Shared Secret (or app-specific shared secret)
APPLE_SHARED_SECRET=

# Set true only for local/dev testing without talking to Apple
APPLE_IAP_SKIP_VERIFY=false

# Set true only for local/dev testing without Google Play Developer API
GOOGLE_IAP_SKIP_VERIFY=false

# Android applicationId (com.fsprogrammers.booqly)
GOOGLE_PLAY_PACKAGE_NAME=com.fsprogrammers.booqly

# Optional – validates suite "Verify via Google Business" links against the
# real Places API server-side. If omitted, place links are recorded as-is.
GOOGLE_PLACES_API_KEY=

# =====================================================
# LOCAL STORAGE CONFIGURATION
# =====================================================

# Base URL for serving uploaded files
BASE_URL=http://localhost:3000

# =====================================================
# EMAIL CONFIGURATION (Brevo SMTP)
# =====================================================

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=ae617f001@smtp-brevo.com
BREVO_SMTP_KEY=your_brevo_smtp_key_here

# The verified sender address from your Brevo account (must match a verified sender)
BREVO_VERIFIED_SENDER=info@booqlyapp.com

# Recipient for website contact form submissions
CONTACT_RECIPIENT_EMAIL=hanzallah.maseed@gmail.com

# =====================================================
# SMS CONFIGURATION
# =====================================================

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# SOCKET.IO CONFIGURATION
# =====================================================

SOCKET_IO_CORS_ORIGIN=http://localhost:3000
