{
  "name": "booqly-server",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "node scripts/e2e-verification-test.cjs",
    "lint": "npx eslint src/**/*.ts",
    "lint:fix": "npx eslint src/**/*.ts --fix",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:prod": "NODE_ENV=production npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo:all",
    "migrate:undo:prod": "NODE_ENV=production npx sequelize-cli db:migrate:undo:all",
    "deploy:setup": "chmod +x scripts/*.sh",
    "health-check": "curl -f http://localhost:3000/health || exit 1",
    "kill-port": "for /f \"tokens=5\" %a in ('netstat -ano ^| findstr :3000') do taskkill //PID %a //F",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:prod": "NODE_ENV=production npx sequelize-cli db:seed:all",
    "db:reset": "npx sequelize-cli db:drop && npx sequelize-cli db:create && npx sequelize-cli db:migrate",
    "init:uploads": "node scripts/init-upload-dirs.js",
    "create-admin": "ts-node src/scripts/create-admin.ts",
    "postbuild": "npm run init:uploads && node -e \"require('fs').copyFileSync('src/utils/pdf-worker-script.mjs','dist/utils/pdf-worker-script.mjs')\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^13.8.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mrz": "^5.0.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1",
    "pino-pretty": "^10.3.1",
    "redis": "^4.6.10",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.4",
    "socket.io": "^4.7.4",
    "stripe": "^14.7.0",
    "tesseract.js": "^7.0.0",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
