# =====================================================
# BOOQLY SERVER PRODUCTION ENVIRONMENT - api.booqlyapp.com
# =====================================================

# Environment
NODE_ENV=production
PORT=3000

# Error Handling
SEND_ERRORS=false

# Base URL for serving uploaded files
BASE_URL=https://api.booqlyapp.com

# Database Configuration
DATABASE_URL=postgresql://booqly_user:booqly_secure_password_2024@localhost:5432/booqly_production

# JWT Configuration (Generate strong secret - minimum 32 characters)
JWT_SECRET_KEY=your_super_secure_jwt_secret_key_minimum_32_characters_long_for_production
JWT_EXPIRES_IN=90d

# Client URL (for CORS and Socket.io)
CLIENT_URL=https://booqlyapp.com
FRONTEND_URL=https://booqlyapp.com
API_URL=https://api.booqlyapp.com

# =====================================================
# STRIPE CONFIGURATION (LIVE KEYS)
# =====================================================

# API Keys (Replace with your live Stripe keys)
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here

# Webhook Secret (Replace with your live webhook secret)
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# =====================================================
# STRIPE PRICE IDs (CREATE IN STRIPE DASHBOARD)
# =====================================================

# Client Subscription Plans
STRIPE_CLIENT_PREMIUM_PRICE_ID=price_live_client_premium_499

# Solo Professional Plans
STRIPE_SOLO_BASIC_PRICE_ID=price_live_solo_basic_1499
STRIPE_SOLO_PRO_PRICE_ID=price_live_solo_pro_2999
STRIPE_SOLO_PREMIUM_PRICE_ID=price_live_solo_premium_4999

# Suite Owner Plans  
STRIPE_SUITE_STARTER_PRICE_ID=price_live_suite_starter_4999
STRIPE_SUITE_GROWING_PRICE_ID=price_live_suite_growing_7499
STRIPE_SUITE_PRO_PRICE_ID=price_live_suite_pro_9999
STRIPE_SUITE_ELITE_PRICE_ID=price_live_suite_elite_14999

# =====================================================
# EMAIL CONFIGURATION
# =====================================================

# Gmail Configuration (Recommended for production)
EMAIL_SERVICE=gmail
EMAIL_USER=noreply@booqlyapp.com
EMAIL_PASS=your_gmail_app_specific_password

# Alternative: SendGrid Configuration
# EMAIL_SERVICE=sendgrid
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your_sendgrid_api_key

# =====================================================
# SMS CONFIGURATION
# =====================================================

# Twilio Configuration (Replace with your production credentials)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# SOCKET.IO CONFIGURATION
# =====================================================

SOCKET_IO_CORS_ORIGIN=https://booqlyapp.com

# =====================================================
# AWS CONFIGURATION (OPTIONAL - FOR FILE STORAGE)
# =====================================================

# AWS S3 Configuration (Optional - for cloud file storage)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=booqly-production-files

# SQS Configuration (Optional - for background jobs)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/booqly-production-queue

# =====================================================
# REDIS CONFIGURATION (OPTIONAL - FOR CACHING)
# =====================================================

# Redis Configuration (Optional - for session management and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# =====================================================
# GOOGLE MAPS CONFIGURATION (FOR LOCATION SERVICES)
# =====================================================

# Google Maps API Key (for location autocomplete)
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =====================================================
# PUSH NOTIFICATION CONFIGURATION
# =====================================================

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=booqly-production
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@booqly-production.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_firebase_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# =====================================================
# LOGGING CONFIGURATION
# =====================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log File Paths
LOG_FILE_PATH=/var/log/booqly/app.log
ERROR_LOG_FILE_PATH=/var/log/booqly/error.log

# =====================================================
# RATE LIMITING CONFIGURATION
# =====================================================

# Rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# SESSION CONFIGURATION
# =====================================================

# Session secret (generate a strong random string)
SESSION_SECRET=your_super_secure_session_secret_key_for_production

# =====================================================
# SECURITY CONFIGURATION
# =====================================================

# CORS Origins (comma-separated list)
CORS_ORIGINS=https://booqlyapp.com,https://www.booqlyapp.com

# Trusted Proxies (for reverse proxy setup)
TRUSTED_PROXIES=127.0.0.1,::1

# =====================================================
# MONITORING CONFIGURATION
# =====================================================

# Application monitoring (optional)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Health check configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# =====================================================
# BACKUP CONFIGURATION
# =====================================================

# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=booqly-production-backups

# =====================================================
# FEATURE FLAGS
# =====================================================

# Feature toggles
ENABLE_CHAT_FEATURE=true
ENABLE_PAYMENT_FEATURE=true
ENABLE_NOTIFICATIONS=true
ENABLE_FILE_UPLOADS=true
ENABLE_SOCIAL_LOGIN=false

# =====================================================
# PERFORMANCE CONFIGURATION
# =====================================================

# Database connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Request timeout (in milliseconds)
REQUEST_TIMEOUT=30000

# File upload limits
MAX_FILE_SIZE=50MB
MAX_FILES_PER_REQUEST=10
