# Environment
NODE_ENV=production

# App
APP_PORT=3000

# Error Handling
SEND_ERRORS=false

# Base URL for serving uploaded files
BASE_URL=https://api.welcomeshah.com

# Production DB (Update these with your production database credentials)
PROD_DB_USERNAME=your-prod-db-username
PROD_DB_PASSWORD=your-prod-db-password
PROD_DB_NAME=your-prod-db-name
PROD_DB_HOST=your-prod-db-host
PROD_DB_PORT=your-prod-db-port

# Development DB (for local development)
DEV_DB_USERNAME=your-dev-db-username
DEV_DB_PASSWORD=your-dev-db-password
DEV_DB_NAME=your-dev-db-name
DEV_DB_HOST=your-dev-db-host
DEV_DB_PORT=your-dev-db-port

# Database URL for Sequelize CLI
DATABASE_URL=postgres://your-prod-db-username:your-prod-db-password@your-prod-db-host:your-prod-db-port/your-prod-db-name

# JWT (Generate a strong secret for production)
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-for-production
JWT_EXPIRES_IN=90d

# AWS Configuration (Update with your production AWS credentials)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=booqly-production-bucket
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/your-account/your-queue

# Stripe Configuration (Update with your production Stripe keys)
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# Stripe Price IDs (Create these in Stripe Dashboard for production)
STRIPE_CLIENT_PREMIUM_PRICE_ID=price_live_client_premium
STRIPE_SOLO_BASIC_PRICE_ID=price_live_solo_basic
STRIPE_SOLO_PRO_PRICE_ID=price_live_solo_pro
STRIPE_SOLO_PREMIUM_PRICE_ID=price_live_solo_premium
STRIPE_SUITE_STARTER_PRICE_ID=price_live_suite_starter
STRIPE_SUITE_GROWING_PRICE_ID=price_live_suite_growing
STRIPE_SUITE_PRO_PRICE_ID=price_live_suite_pro
STRIPE_SUITE_ELITE_PRICE_ID=price_live_suite_elite

# Email Configuration (Update with your production email service)
EMAIL_SERVICE=gmail
EMAIL_USER=your-production-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# SMS Configuration (Update with your production SMS service)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Domain Configuration
FRONTEND_URL=https://welcomeshah.com
API_URL=https://api.welcomeshah.com
